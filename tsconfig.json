{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"],
      "@/components/*": ["./components/*"],
      "@/lib/utils/*": ["./lib/utils/*"]
    }
  },
  "include": [
    "nuxt.config.ts",
    "components/**/*.ts",
    "composables/**/*.ts",
    "lib/**/*.ts",
    "pages/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
